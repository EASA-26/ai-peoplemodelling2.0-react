# Reference for the server's .env.local. Copy to .env.local on the server and fill in.
# .env.local is gitignored and must stay that way: it holds a token.
#
# FORMAT RULES (each one has cost somebody an afternoon):
#   KEY=value   -- no quotes, no spaces around "=", no "#" inside a value
#   The file must be named exactly .env.local. Notepad's "Save As" silently writes
#   .env.local.txt, which is ignored without a word. Check with:  dir .env*
#   The app reads this once at startup: restart the task after any edit.

# --- Where it listens -------------------------------------------------------
# Loopback only; IIS reverse-proxies to it. Must match the -Backend port given to
# setup-hana-path.ps1 and the port scripts\auto-deploy.ps1 health-checks (it reads
# this file for it, so change it in one place).
PORT=8021

# --- Storage ----------------------------------------------------------------
# SQLite database and uploaded files. Must be a durable path: left unset, the app
# falls back through a chain that ends in a temp directory, and uploads vanish on
# reboot.
HR_PEOPLE_APP_STORAGE_ROOT=D:\EASA\PeopleModelling\.app_state

# --- Databricks inference ---------------------------------------------------
# Off Databricks the SDK authenticates from these two. Without them the app still
# runs: uploads, the rules-based shortlist, person-to-position, analytics and audit
# all work, and only the AI readiness column fails.
#
# PASTE THE TOKEN IN YOURSELF, on the server. Never through chat, a command line, a
# script or a commit.
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=
ENDPOINT_NAME=databricks-llama-4-maverick
